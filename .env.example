# API config
PORT=4000
DATABASE_PATH=./data/db/inventory.sqlite
JWT_SECRET=change-me-in-production-please
# Trust X-Real-IP / X-Forwarded-For for rate-limit keys ('true') — only when
# ALL traffic reaches the API through our nginx proxy. Default (unset) keys
# on the socket address: safe when the API port is exposed directly, but
# clients behind a proxy then share one bucket.
#TRUST_PROXY=true

# GM Assistant integration (server-side only — the API key is encrypted at
# rest and never reaches the browser)
#GMA_BASE_URL=https://backend.gmassistant.app/v1
#GMA_TIMEOUT_MS=8000
#GMA_CACHE_TTL_MS=300000
# Dedicated AES key material for stored GMA keys (falls back to JWT_SECRET;
# rotating either means the MD re-enters their key)
#GMA_SECRET=

# Web Push notifications (VAPID) — all three together, or push stays disabled
# (routes degrade cleanly, nothing crashes). Generate once: npm run vapid-keys
# and NEVER rotate afterwards: new keys orphan every existing subscription.
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
# mailto: contact — required by Apple's push service
#VAPID_SUBJECT=mailto:you@example.com

# Emails transactionnels (réinitialisation de mot de passe) — provider
# Mailjet, contrat provider-agnostique côté API. Tout-ou-rien comme VAPID :
# vars absentes = fonctionnalité éteinte (forgot-password répond 503). Les
# clés viennent de https://app.mailjet.com (Account Settings → API keys).
# EMAIL_FROM_ADDRESS doit être une adresse EXPÉDITRICE VÉRIFIÉE chez Mailjet.
#MAILJET_API_KEY=
#MAILJET_API_SECRET=
#EMAIL_FROM_ADDRESS=no-reply@votre-domaine.fr
#EMAIL_FROM_NAME=Table Sync
# Origine publique du web pour les liens des e-mails — vide = en-tête Origin
# des requêtes (correct derrière nginx comme en dev via le proxy Vite).
#APP_URL=https://table-sync.example.fr

# Web config (Vite needs VITE_ prefix)
VITE_API_URL=http://localhost:4000
