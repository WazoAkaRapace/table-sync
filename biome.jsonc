{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/.git",
      "!**/dist",
      "!data",
      "!package-lock.json",
      "!gui-test-screenshots",
      // drizzle-kit's generated migration SQL + meta snapshots must never be
      // reformatted — the migrator hashes their exact content.
      "!apps/api/drizzle",
      // Mimosa security-hook session state — tool output, not source.
      "!**/.mimosa"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      // Tailwind v4: @theme, @apply, @variant, etc. in index.css
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        // Raw SQLite rows are mapped with `as any` across the API — the
        // codebase's data-mapping convention; typing 268 call sites is out
        // of scope for lint setup.
        "noExplicitAny": "off"
      },
      "style": {
        // `!` assertions are used deliberately (guards verified upstream).
        "noNonNullAssertion": "off"
      },
      "a11y": {
        // Modals and bottom sheets deliberately focus their first input.
        "noAutofocus": "off",
        // The app is mobile-first: overlays dismiss on tap-outside and the
        // dock/custom cards use div click zones by design. Keyboard/Escape
        // handling lives in the modal components, not on each div.
        "useKeyWithClickEvents": "off",
        "noStaticElementInteractions": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
