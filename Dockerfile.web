# Web: React + Vite → served by nginx
FROM node:22-alpine AS builder
WORKDIR /app

# Build tools needed for native workspace deps (better-sqlite3 compiles during npm ci)
RUN apk add --no-cache python3 make g++

# Install all workspace dependencies
COPY package.json package-lock.json* ./
COPY tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
RUN npm ci || npm install

# Copy source — shared types + web app
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/

# Build the frontend (API URL injected at build time via VITE_API_URL)
# Empty VITE_API_URL means the frontend uses same-origin (nginx proxies /api)
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL

# Version stampée dans le bundle + version.json — le SHA du commit en CI,
# « dev » en local. L'ARG transite par ENV : vite.config.ts lit process.env.
ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION
WORKDIR /app/apps/web
# Typecheck first: vite/esbuild strips types without checking them.
# `tsc -b` also covers packages/shared (imported as raw TS sources).
# Baseline is clean since Aug 2026 — the build fails on any type error.
RUN npx tsc -b
RUN npx vite build

# --- Production stage: nginx ---
FROM nginx:alpine
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
